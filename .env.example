# Django
SECRET_KEY=your-secret-key

# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=weather_reminder
POSTGRES_HOST=db
POSTGRES_PORT=5432

# OpenWeatherMap
OPEN_WEATHER_API_KEY=your-openweathermap-api-key

# Email (Gmail SMTP)
EMAIL_HOST_USER=your-email@gmail.com
